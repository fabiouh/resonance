{
  "name": "resonance",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "tauri": "node scripts/tauri.mjs",
    "validate": "pnpm format:check && pnpm check && pnpm lint && pnpm test && pnpm build && cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml --all-features",
    "release": "node scripts/release.mjs",
    "test:desktop": "node scripts/smoke.mjs",
    "test:desktop:release": "node scripts/smoke.mjs --release"
  },
  "dependencies": {
    "@lucide/svelte": "^1.49.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.11.0",
    "@types/node": "^24.0.0",
    "@types/youtube": "^0.1.2",
    "eslint": "^10.11.0",
    "eslint-plugin-svelte": "^3.16.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.1",
    "vitest": "^4.0.0"
  }
}
